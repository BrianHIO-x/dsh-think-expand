{
  "name": "dsh-think-expand",
  "version": "0.1.3",
  "scripts": {
    "test": "node --test"
  },
  "description": "Auto-expand every Think row, opening the DSH 0.1.7 step groups and folded turns that hold them. Header switch to turn it on or off.",
  "type": "module",
  "license": "MIT",
  "author": "BrianHIO-x",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BrianHIO-x/dsh-think-expand.git"
  },
  "bugs": {
    "url": "https://github.com/BrianHIO-x/dsh-think-expand/issues"
  },
  "homepage": "https://github.com/BrianHIO-x/dsh-think-expand#readme",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "think",
    "reasoning"
  ],
  "engines": {
    "node": ">=20",
    "dsh": ">=0.1.7-rc.2"
  },
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4"
  },
  "devDependencies": {
    "jsdom": "^26.1.0"
  }
}
